# Copy to secrets/google-ads.yaml and fill in values from Google Cloud / Ads API setup.
# Never commit the filled-in file.

developer_token: YOUR_GOOGLE_ADS_DEVELOPER_TOKEN
client_id: YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com
client_secret: YOUR_OAUTH_CLIENT_SECRET
refresh_token: YOUR_OAUTH_REFRESH_TOKEN
use_proto_plus: True

# Required when accessing client accounts through an MCC/manager account
login_customer_id: "YOUR_MCC_CUSTOMER_ID"
